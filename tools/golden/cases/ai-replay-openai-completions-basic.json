	"context": {
		"messages": [{ "role": "user", "content": "Say hello", "timestamp": 0 }]
	},
	"options": { "apiKey": "test", "maxRetries": 0 },
	"fixture": {
		"headers": { "content-type": "text/event-stream" },
		"events": [
			{ "data": "{\"id\":\"chatcmpl-basic\",\"choices\":[{\"index\":0,\"delta\":{\"role\":\"assistant\",\"content\":\"Hello\"},\"finish_reason\":null}]}" },
			{ "data": "{\"id\":\"chatcmpl-basic\",\"choices\":[{\"index\":0,\"delta\":{\"content\":\", world!\"},\"finish_reason\":null}]}" },
			{ "data": "{\"id\":\"chatcmpl-basic\",\"choices\":[{\"index\":0,\"delta\":{},\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":5,\"completion_tokens\":3,\"total_tokens\":8}}" },
			{ "data": "[DONE]" }
		]
	}
}
