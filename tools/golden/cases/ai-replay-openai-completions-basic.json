{
	"name": "ai-replay-openai-completions-basic",
	"kind": "ai-replay",
	"api": "openai-completions",
	"model": {
		"id": "gpt-4o-mini",
		"name": "gpt-4o-mini",
		"provider": "test-replay",
		"reasoning": false,
		"input": ["text"],
		"cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 },
		"contextWindow": 128000,
		"maxTokens": 4096
